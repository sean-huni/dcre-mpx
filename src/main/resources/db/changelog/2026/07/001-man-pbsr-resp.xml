<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ===================================================================================
         V1 BASELINE (SCRUM-107, owner directive 2026-08-08). THIS FILE IS THE FIRST AND ONLY
         MIGRATION THAT EVER MINTS man_pbsr_resp.

         Every DCRE database is dropped and recreated for the direct cut-over, so there is no
         historic dcre_man, no MAR-era shape of this table and nothing to retrofit. The
         apparatus a migration needs is ABSENT BY DESIGN and must not be re-added here: no
         <validCheckSum>ANY</validCheckSum> (no checksum was ever recorded), no defensive
         IF NOT EXISTS on the CREATE, no additive addColumn walking an older shape forward.
         The table's final shape is the createTable below and nothing else edits it.

         THE TWO MARK_RAN GUARDS IN THIS FILE ARE CONVERGENCE GUARDS, NOT RETROFITS. They are
         load-bearing on a brand-new dcre_man because man_pbsr_resp has TWO creators:
         this file, and MRG's db/changelog/2026/07/004-man-views.xml changeset
         004-bootstrap-man-pbsr-resp-mrg, which pre-creates the table (and its unique
         constraint) so MRG's mnd_pbsr_pick view can compile before MPX has ever run. All ten
         M-services migrate the one dcre_man with ten independent history + lock tables and
         NOTHING serializes them, so either writer can genuinely arrive first. Each guard
         below names the writer it converges with.
         =================================================================================== -->

    <!-- SCRUM-91: MPX is the single RUNTIME writer of man_pbsr_resp, the pain.012 PBSR
         acceptance-leg response table, and of NOTHING else. The isr and sbsr
         tables moved out with their own services (MIX, MSX): one reader per leg,
         the exact mirror of the collections cix/csx/cpx fleet. The merged
         three-table changelog was MAR's shape and is the deviation this refactor
         removes, so the reply.type launch arg is gone too: the leg is a
         compile-time property of the service.

         DELAYED AUTHENTICATION, the one behavior only this leg has (documented
         here and in NO other leg's changelog): the debtor may authenticate late,
         so a SECOND PBSR arrives for the SAME mandate under a DISTINCT file stem
         (<stem>-AUTH_PBSR.xml). BOTH rows must persist, and they do precisely
         because the UNIQUE constraint below is the FULL business identity
         (response_file, mndt_req_id) and not mndt_req_id alone: a distinct file is
         a distinct row, so the earlier PDNG arrival and the later ACCP arrival
         stand side by side and the mnd_pbsr_pick precedence view selects the later
         one. A key narrower than the entity's uniqueness tuple would silently
         swallow the authentication (engineering.md idempotency-key rule).

         One row per reply file (a pain.012 message carries exactly ONE mandate,
         unlike the collections ISR fan-out). Replay-safe and resume-safe via that
         same UNIQUE (response_file, mndt_req_id), so the guarded
         INSERT ... ON CONFLICT (response_file, mndt_req_id) DO NOTHING is a
         zero-duplicate no-op on re-run (never UPSERT on the PK; CRDB resolves
         UPSERT on PK only, persistence.md).
         orgnl_msg_id = the outbound MsgId MPX correlates to man_outbound.out_msg_id
         (fail-closed: an unknown outbound identity is WARNed and excluded, never
         guessed, SCRUM-60 canon). mndt_id = the MndtId (mandate_ref), mndt_req_id =
         the MRR-minted MndtReqId. e2e is nullable-but-forward-compatible: the
         current synthetic pain.012 contract (A-60) carries no EndToEndId element,
         so it is parsed opportunistically and stays NULL until the reply shape
         carries it. status/reason are the literal MndtSts/Rsn code values (R-21:
         code values, never enum ordinals). -->

    <changeSet id="mpx-001-man-pbsr-resp" author="dcre">
        <!-- CONVERGENCE GUARD: MRG's 004-man-views.xml changeset 004-bootstrap-man-pbsr-resp-mrg
             creates this same table so its mnd_pbsr_pick view has a source, and nothing orders
             the two services' Liquibase runs. Whichever arrives second MARK_RANs. See the file
             header. -->
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="man_pbsr_resp"/></not>
        </preConditions>
        <createTable tableName="man_pbsr_resp">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="response_file" type="VARCHAR(128)"><constraints nullable="false"/></column>
            <column name="orgnl_msg_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="mndt_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="mndt_req_id" type="VARCHAR(35)"><constraints nullable="false"/></column>
            <column name="e2e" type="VARCHAR(35)"/>
            <column name="status" type="VARCHAR(8)"><constraints nullable="false"/></column>
            <column name="reason" type="VARCHAR(8)"/>
            <column name="version" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- CONVERGENCE GUARD, and the reason the constraint is its OWN changeset: it is guarded on
         its OWN schema state, never on file order (persistence.md). Folded into the createTable
         changeset above, the single tableExists gate would MARK_RAN BOTH statements against a
         database where the other creator put the TABLE in place but not yet the CONSTRAINT, and
         then every runtime ON CONFLICT (response_file, mndt_req_id) dies with "there is no
         unique or exclusion constraint matching the ON CONFLICT specification": the
         zero-duplicate idempotency guarantee silently gone. MRG's
         004-bootstrap-man-pbsr-resp-mrg is the other creator and mints table and constraint
         together, so this split is what keeps MPX correct if that pairing ever separates, and
         it costs one precondition. A UNIQUE constraint materialises as an index of the same
         name, so indexExists is the schema-state probe for it. Proven by the table-without-
         constraint fixture in MpxLegacyStateIT (SCRUM-91 review R5). -->
    <changeSet id="mpx-001-man-pbsr-resp-uq" author="dcre">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="man_pbsr_resp" indexName="uq_man_pbsr_resp_file_mndt_req"/></not>
        </preConditions>
        <addUniqueConstraint tableName="man_pbsr_resp" columnNames="response_file, mndt_req_id"
                             constraintName="uq_man_pbsr_resp_file_mndt_req"/>
    </changeSet>

</databaseChangeLog>
